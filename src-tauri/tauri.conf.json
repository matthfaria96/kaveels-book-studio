{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaveel's Book Studio",
  "version": "0.1.2",
  "identifier": "app.kaveels.bookstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Kaveel's Book Studio",
      "width": 1400, "height": 880, "minWidth": 1000, "minHeight": 640,
      "dragDropEnabled": true, "backgroundColor": "#14110f"
    }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
